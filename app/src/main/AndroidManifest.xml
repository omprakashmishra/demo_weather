<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".common.BaseApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.WeatherSample"
        tools:targetApi="31">

        <activity
            android:name=".presentation.ui.SplashAc"
            android:exported="true"
            android:theme="@style/Theme.WeatherSample.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".presentation.ui.loginReg.LoginAc"
            android:exported="true"
            android:theme="@style/Theme.WeatherSample.NoActionBar" />
        <activity
            android:name=".presentation.ui.loginReg.RegisterAc"
            android:exported="true"
            android:theme="@style/Theme.WeatherSample.NoActionBar" />
        <activity
            android:name=".presentation.ui.dashboard.ActivityDashboard"
            android:exported="true"
            android:theme="@style/Theme.WeatherSample.NoActionBar" />
    </application>

</manifest>